  const row=await db.prepare(`SELECT * FROM admin_order_queue WHERE id=? LIMIT 1`).bind(orderId).first();
  if(!row) {
    const existing=await db.prepare(`SELECT id,status FROM admin_orders WHERE id=? LIMIT 1`).bind(orderId).first();
    if(!existing) return false;
    if(normalized==="returned"&&existing.status!=="returned") return await updateAdminOrderStatus(db,actorId,orderId,{status:"returned"});
    return true;
  }
  if(normalized==="returned") {
    if(row.payment_source!=="admin_offline"||row.payment_status!=="Paid")
      throw new AppError("A provider-paid admin order must be refunded through the payment provider before it can be released.",409);
    await deleteQueuedAdminOrder(db,orderId);
    return {id:row.id,status:"returned",released:true};
  }
  const timestamp=nowISO();
  const orderNumber=row.order_number,vnCode=row.vn_code;
  if(!/^\d{6}$/.test(String(orderNumber))||!/^VN-A\d{2,}$/.test(String(vnCode)))
    throw new AppError("The reserved admin order identifiers are invalid. Refresh and retry.",409);
  const orderObject=parseJSON(row.order_json,{});
  orderObject.orderNumber=orderNumber;orderObject.vnCode=vnCode;
  orderObject.orderStatus="Delivered";orderObject.status="delivered";
  orderObject.paymentStatus="Paid";orderObject.paymentNumber=row.payment_number||null;
  const insert=db.prepare(`INSERT INTO admin_orders (
    id,user_id,order_number,vn_code,created_at,updated_at,delivered_at,returned_at,returned_by,status,
    customer_json,items_json,subtotal,shipping,taxes,total,currency,country_code,shipping_method,payment_method,
    payment_status,payment_number,order_json,payment_source
  ) VALUES (?,?,?,?,?,?,?,NULL,NULL,'delivered',?,?,?,?,?,?,?,?,?,?,?,?,?,'admin_offline')`)
    .bind(row.id,row.user_id,orderNumber,vnCode,row.created_at,timestamp,timestamp,row.customer_json,row.items_json,
      row.subtotal,row.shipping,row.taxes,row.total,row.currency,row.country_code,row.shipping_method,row.payment_method,
      "Paid",row.payment_number||null,JSON.stringify(orderObject));
  const markPermanent=db.prepare(`UPDATE admin_order_number_registry SET state='permanent' WHERE admin_order_id=? AND order_number=?`).bind(row.id,orderNumber);
  const audit=db.prepare(`INSERT INTO admin_order_events(id,admin_order_id,event_type,actor_id,details_json,created_at)
    VALUES (?,?,?,?,?,?)`).bind(randomId("aoe_"),row.id,"created",actorId,JSON.stringify({status:"delivered",order_number:orderNumber,vn_code:vnCode}),timestamp);
  const remove=db.prepare(`DELETE FROM admin_order_queue WHERE id=?`).bind(orderId);
  await db.batch([insert,markPermanent,audit,remove]);
  return {id:row.id,orderNumber,vnCode,status:"delivered"};
}

