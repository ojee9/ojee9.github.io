  await db.prepare(`INSERT OR IGNORE INTO admin_order_number_registry(order_number,admin_order_id,created_at,state)
    SELECT order_number,id,created_at,'permanent' FROM admin_orders`).run();
  await db.prepare(`
    INSERT OR IGNORE INTO customer_return_item_claims (order_item_id,return_id,status,created_at)
