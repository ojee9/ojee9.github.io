async function updateOrderStatus(db, orderId, body, actorId = "operator") {
  const requested=validText(body.orderStatus ?? body.status,60).toLowerCase();
  const canonical={received:"Received",preparing:"Preparing",delivering:"On Shipping","on shipping":"On Shipping",shipped:"On Shipping",delivered:"Delivered",cancelled:"Cancelled"};
  const status=canonical[requested];
  if (!status) throw new AppError("Invalid order status.");
  const record=await db.prepare(`SELECT order_status,created_by_admin,payment_source,payment_status FROM customer_orders WHERE id=? AND COALESCE(is_admin_order,0)=0 LIMIT 1`).bind(orderId).first();
  if (!record) return false;
  if(status==="Cancelled"&&Number(record.created_by_admin)===1&&record.payment_source==="admin_offline"&&record.payment_status==="Paid")
    throw new AppError("Admin-created offline-paid orders must be removed with the × control, not cancelled.",409);
  const current=String(record.order_status||"Received");
  if (current===status) return true;
  const transitions={Received:["Preparing","Cancelled"],Preparing:["On Shipping","Cancelled"],"On Shipping":["Delivered","Cancelled"],Delivering:["Delivered","Cancelled"]};
  if (!(transitions[current]||[]).includes(status)) throw new AppError("Invalid order status transition.",409);
  const reason=validText(body.cancellation_reason ?? body.reason,120);
  const reasons=["High workload","Out of stock","Suspicious purchase","Address or delivery information issue","Product unavailable","Payment could not be verified","Customer request","Other"];
  if (status==="Cancelled" && !reasons.includes(reason)) throw new AppError("Select a valid cancellation reason.");
  const timestamp=nowISO(), historyId=randomId("osh_"), eventId=randomId("ose_");
  const results=await db.batch([
    db.prepare(`UPDATE customer_orders SET order_status=?,updated_at=?,delivered_at=CASE WHEN ?='Delivered' THEN ? ELSE delivered_at END WHERE id=? AND order_status=?`).bind(status,timestamp,status,timestamp,orderId,current),
    db.prepare(`INSERT INTO order_status_history (id,order_id,from_status,to_status,actor_id,reason,created_at) SELECT ?,?,?,?,?,?,? WHERE changes()=1`).bind(historyId,orderId,current,status,actorId,reason||null,timestamp),
    db.prepare(`INSERT INTO order_status_events (id,order_id,from_status,to_status,actor_id,reason,created_at) SELECT ?,?,?,?,?,?,? WHERE EXISTS (SELECT 1 FROM order_status_history WHERE id=?)`).bind(eventId,orderId,current,status,actorId,reason||null,timestamp,historyId)
  ]);
  if (!results?.[0]?.meta?.changes) throw new AppError("Order status changed before this update could be saved. Refresh and try again.",409);
  return true;
}

async function createReturn(db, userId, body) {
  const orderId=validText(body.order_id ?? body.orderId,150), reason=validText(body.reason,500);
  const customerNote=validText(body.customer_note ?? body.customerNote,3000);
  const selectedIds=Array.isArray(body.item_ids)?body.item_ids:Array.isArray(body.itemIds)?body.itemIds:[];
  if (!orderId || !reason) throw new AppError("Order and return reason are required.");
  if (!selectedIds.length || selectedIds.length>100) throw new AppError("Select at least one product.");
  const order=await getOrderForUser(db,userId,orderId);
  if (!order) throw new AppError("Order not found.",404);
  if (String(order.payment_status||"").toLowerCase()!=="paid") throw new AppError("Only paid orders are eligible for a return request.",409);
  if (String(order.order_status||"").toLowerCase()!=="delivered") throw new AppError("A return can only be requested after delivery.",409);
  const deliveredAt=Date.parse(order.delivered_at||"");
  if (!Number.isFinite(deliveredAt) || deliveredAt>Date.now()) throw new AppError("The delivery date is missing or invalid. Contact support.",409);
  const returnWindowDays=String(order.country_code||"").toUpperCase()==="TR"?14:30;
  if (Date.now()-deliveredAt>returnWindowDays*24*60*60*1000) throw new AppError(`The ${returnWindowDays}-day return request period has expired.`,409);
  const ids=[...new Set(selectedIds.map(x=>validText(x,150)).filter(Boolean))];
  if (ids.length!==selectedIds.length) throw new AppError("Duplicate or invalid item selection.");
  const placeholders=ids.map(()=>"?").join(",");
  const selected=await db.prepare(`SELECT * FROM customer_order_items WHERE order_id=? AND active=1 AND id IN (${placeholders})`).bind(orderId,...ids).all();
  const items=selected.results||[];
  if (items.length!==ids.length) throw new AppError("One or more selected products are unavailable.",409);
  const existing=await db.prepare(`SELECT ri.order_item_id FROM customer_return_items ri JOIN customer_returns r ON r.id=ri.return_id WHERE r.order_id=? AND lower(r.status) IN ('pending','accepted','return process','returned') AND ri.order_item_id IN (${placeholders})`).bind(orderId,...ids).all();
  if ((existing.results||[]).length) throw new AppError("One or more selected products already have an active or completed return request.",409);
  const returnId=randomId("return_"), timestamp=nowISO();
  const statements=[
    db.prepare(`INSERT INTO customer_returns (id,user_id,order_id,order_number,reason,customer_note,status,created_at,updated_at) VALUES (?,?,?,?,?,?,'Pending',?,?)`).bind(returnId,userId,orderId,order.order_number,reason,customerNote,timestamp,timestamp)
  ];
  for (const item of items) {
    statements.push(db.prepare(`INSERT INTO customer_return_items (id,return_id,order_item_id,item_json,quantity) VALUES (?,?,?,?,?)`).bind(randomId("return_item_"),returnId,item.id,item.item_json,item.quantity));
    statements.push(db.prepare(`INSERT INTO customer_return_item_claims (order_item_id,return_id,status,created_at) VALUES (?,?,?,?)`).bind(item.id,returnId,"Pending",timestamp));
  }
