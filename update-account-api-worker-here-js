const JSON_HEADERS = {
  "Content-Type": "application/json; charset=utf-8",
  "Cache-Control": "no-store",
  "X-Content-Type-Options": "nosniff",
  "Referrer-Policy": "no-referrer",
  "X-Frame-Options": "DENY"
};

function json(data, status = 200, extraHeaders = {}) {
  return new Response(JSON.stringify(data), {
    status,
    headers: { ...JSON_HEADERS, ...extraHeaders }
  });
}

function error(message, status = 400) {
  return json({ error: message }, status);
}

function nowISO() {
  return new Date().toISOString();
}

function randomId(prefix = "") {
  return `${prefix}${crypto.randomUUID()}`;
}

function randomDigits(length) {
  if (!Number.isInteger(length) || length < 1 || length > 9) throw new AppError("Invalid identifier length.");
  const max = 10 ** length;
  const limit = Math.floor(0x100000000 / max) * max;
  const bytes = new Uint32Array(1);
  let value;
  do { crypto.getRandomValues(bytes); value = bytes[0]; } while (value >= limit);
  return String(value % max).padStart(length, "0");
}



function base64UrlToBytes(value) {
  const normalized = value.replace(/-/g, "+").replace(/_/g, "/");
  const padded = normalized.padEnd(
    normalized.length + ((4 - normalized.length % 4) % 4),
    "="
  );

  const binary = atob(padded);
  const bytes = new Uint8Array(binary.length);

  for (let i = 0; i < binary.length; i++) {
    bytes[i] = binary.charCodeAt(i);
  }

  return bytes;
}

function base64UrlToString(value) {
  return new TextDecoder().decode(base64UrlToBytes(value));
}

function bytesToBase64Url(bytes) {
  let binary = "";

  for (const byte of bytes) {
    binary += String.fromCharCode(byte);
  }

  return btoa(binary)
    .replace(/\+/g, "-")
    .replace(/\//g, "_")
    .replace(/=+$/g, "");
}

async function sha256(value) {
  const digest = await crypto.subtle.digest(
    "SHA-256",
    new TextEncoder().encode(value)
  );

  return bytesToBase64Url(new Uint8Array(digest));
}

function validText(value, maxLength = 500) {
  if (typeof value !== "string") return "";
  return value.trim().slice(0, maxLength);
}

function validNumber(value, fallback = 0) {
  const number = Number(value);
  return Number.isFinite(number) ? number : fallback;
}

function normalizeEmail(value) {
  return validText(value, 320).toLowerCase();
}

function parseJSON(value, fallback = null) {
  if (value === null || value === undefined) return fallback;
  if (typeof value === "object") return value;

  try {
    return JSON.parse(value);
  } catch {
    return fallback;
  }
}

async function isAdmin(env, userId) {
  if (typeof userId !== "string" || !userId.startsWith("vn_")) return false;
  try {
    const account = await env.DB.prepare(`
      SELECT email, role FROM vn_accounts WHERE account_id = ? LIMIT 1
    `).bind(userId).first();
    return Boolean(account && (account.role === "admin" || ADMIN_EMAILS.has(normalizeEmail(account.email))));
  } catch {
    return false;
  }
}

async function getJWKS() {
  if (jwksCache && Date.now() < jwksCacheExpiresAt) {
    return jwksCache;
  }

  const response = await fetch(JWKS_URL, {
    headers: { Accept: "application/json" }
  });

  if (!response.ok) {
    throw new Error("Unable to retrieve signing keys.");
  }

  const data = await response.json();

  if (!Array.isArray(data.keys)) {
    throw new Error("Invalid signing keys.");
  }

  jwksCache = data;
  jwksCacheExpiresAt = Date.now() + 60 * 60 * 1000;

  return jwksCache;
}

async function verifyClerkSignature(parts, jwk, claims) {
  try {
    const publicKey = await crypto.subtle.importKey(
      "jwk",
      jwk,
      {
        name: "RSASSA-PKCS1-v1_5",
        hash: "SHA-256"
      },
      false,
      ["verify"]
    );

    const signature = base64UrlToBytes(parts[2]);
    const signedData = new TextEncoder().encode(
      `${parts[0]}.${parts[1]}`
    );

    const valid = await crypto.subtle.verify(
      "RSASSA-PKCS1-v1_5",
      publicKey,
      signature,
      signedData
    );

    return valid ? claims : null;
  } catch {
    return null;
  }
}

async function authenticateClerk(request) {
  const authorization = request.headers.get("Authorization") || "";
  const match = authorization.match(/^Bearer\s+(.+)$/i);

  if (!match) return null;

  const parts = match[1].split(".");
  if (parts.length !== 3) return null;

  try {
    const header = JSON.parse(base64UrlToString(parts[0]));
    const claims = JSON.parse(base64UrlToString(parts[1]));

    if (header.alg !== "RS256" || !header.kid) return null;
    if (claims.iss !== CLERK_ISSUER) return null;

    if (
      typeof claims.sub !== "string" ||
      !claims.sub.startsWith("user_")
    ) {
      return null;
    }

    const currentTime = Math.floor(Date.now() / 1000);
    if (!Number.isFinite(claims.exp) || claims.exp <= currentTime) return null;
    if (claims.iat !== undefined && (!Number.isFinite(claims.iat) || claims.iat > currentTime + 60)) return null;
    if (claims.nbf !== undefined && (!Number.isFinite(claims.nbf) || claims.nbf > currentTime)) return null;
    if (claims.azp !== undefined && claims.azp !== ALLOWED_ORIGIN) return null;

    let jwks = await getJWKS();
    let jwk = jwks.keys.find(key => key.kid === header.kid);

    if (!jwk) {
      jwksCache = null;
      jwksCacheExpiresAt = 0;

      jwks = await getJWKS();
      jwk = jwks.keys.find(key => key.kid === header.kid);

      if (!jwk) return null;
    }

    return await verifyClerkSignature(parts, jwk, claims);
  } catch {
    return null;
  }
}

function getBearerToken(request) {
  const authorization = request.headers.get("Authorization") || "";
  const match = authorization.match(/^Bearer\s+(.+)$/i);
  return match ? match[1] : null;
}

async function createSession(db, userId) {
  await db.prepare(`DELETE FROM customer_sessions WHERE expires_at<=?`).bind(nowISO()).run();
  const token = bytesToBase64Url(
    crypto.getRandomValues(new Uint8Array(32))
  );

  const tokenHash = await sha256(token);
  const createdAt = nowISO();
  const expiresAt = new Date(
    Date.now() + SESSION_TTL_MS
  ).toISOString();

  await db.prepare(`
    INSERT INTO customer_sessions (
      user_id,
      token_hash,
      created_at,
      expires_at
    )
    VALUES (?, ?, ?, ?)
  `).bind(
    userId,
    tokenHash,
    createdAt,
    expiresAt
  ).run();

  return { token, expiresAt };
}

async function authenticateWorkerSession(request, db) {
  const token = getBearerToken(request);
  if (!token) return null;

  const tokenHash = await sha256(token);

  const session = await db.prepare(`
    SELECT user_id, expires_at
    FROM customer_sessions
    WHERE token_hash = ?
    LIMIT 1
  `).bind(tokenHash).first();

  if (!session) return null;

  if (
    !session.expires_at ||
    new Date(session.expires_at).getTime() <= Date.now()
  ) {
    await db.prepare(`
      DELETE FROM customer_sessions
      WHERE token_hash = ?
    `).bind(tokenHash).run();

    return null;
  }

  return { sub: session.user_id };
}

async function authenticateRequest(request, db) {
  return await authenticateWorkerSession(request, db);
}

async function getVerifiedClerkIdentity(env, claims) {
  if (!env.CLERK_SECRET_KEY) throw new AppError("Email verification service is temporarily unavailable.", 503);
  if (!claims?.sub) throw new AppError("Your sign-in session is invalid. Please sign in again.", 401);

  let response;
  try {
    response = await fetch(`https://api.clerk.com/v1/users/${encodeURIComponent(claims.sub)}`, {
      headers: { Authorization: `Bearer ${env.CLERK_SECRET_KEY}`, Accept: "application/json" }
    });
  } catch (err) {
    console.error("Clerk identity lookup failed:", err);
    throw new AppError("Email verification service is temporarily unavailable.", 503);
  }

  if (response.status === 404) throw new AppError("Your sign-in account could not be found. Please sign in again.", 401);
  if (response.status === 401 || response.status === 403) {
    console.error("Clerk identity lookup rejected the configured credentials.");
    throw new AppError("Email verification service is temporarily unavailable.", 503);
  }
  if (!response.ok) {
    console.error("Clerk identity lookup returned HTTP", response.status);
    throw new AppError("Email verification service is temporarily unavailable.", 503);
  }

  let user;
  try {
    user = await response.json();
  } catch (err) {
    console.error("Clerk identity response was invalid:", err);
    throw new AppError("Email verification service returned an invalid response.", 502);
  }

  const entries = Array.isArray(user.email_addresses) ? user.email_addresses : [];
  const primary = entries.find(item => item.id === user.primary_email_address_id && item.verification?.status === "verified")
    || entries.find(item => item.verification?.status === "verified");
  const email = normalizeEmail(primary?.email_address || "");
  if (!email) throw new AppError("A verified email address is required.", 403);
  return { email, clerkUserId: claims.sub, firstName: validText(user.first_name || "", 120), lastName: validText(user.last_name || "", 120) };
}

