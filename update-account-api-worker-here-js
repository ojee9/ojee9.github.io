async function migrateLegacyAccount(db, legacyUserId, accountId) {
  if (!legacyUserId || legacyUserId === accountId) return;
  const profileColumns = await getColumns(db, "customer_profiles");
  const oldProfile = await db.prepare("SELECT * FROM customer_profiles WHERE user_id = ? LIMIT 1").bind(legacyUserId).first();
  const newProfile = await db.prepare("SELECT * FROM customer_profiles WHERE user_id = ? LIMIT 1").bind(accountId).first();
  if (oldProfile && !newProfile) {
    await db.prepare("UPDATE customer_profiles SET user_id = ?, updated_at = ? WHERE user_id = ?").bind(accountId, nowISO(), legacyUserId).run();
  } else if (oldProfile && newProfile) {
    const fields = ["first_name","last_name","phone","country","country_code","marketing_consent","date_of_birth","avatar_url"];
    const updates = fields.filter(field => profileColumns.includes(field) && oldProfile[field] != null && oldProfile[field] !== "");
    if (updates.length) {
      await db.prepare(`UPDATE customer_profiles SET ${updates.map(field => `${field} = COALESCE(NULLIF(${field}, ''), ?)`).join(", ")}, updated_at = ? WHERE user_id = ?`)
        .bind(...updates.map(field => oldProfile[field]), nowISO(), accountId).run();
    }
    await db.prepare("DELETE FROM customer_profiles WHERE user_id = ?").bind(legacyUserId).run();
  }
  for (const table of ["customer_addresses", "customer_orders", "customer_returns", "admin_orders", "admin_order_queue", "issues"]) {
    const columns = await getColumns(db, table);
    if (columns.includes("user_id")) await db.prepare(`UPDATE ${table} SET user_id = ? WHERE user_id = ?`).bind(accountId, legacyUserId).run();
  }
}

async function resolveVNAccount(db, identity) {
  const email = normalizeEmail(identity.email);
  if (!email) throw new AppError("Verified email is missing.", 401);
  let account = await db.prepare("SELECT * FROM vn_accounts WHERE email = ? COLLATE NOCASE LIMIT 1").bind(email).first();
  if (!account && identity.clerkUserId) {
    account = await db.prepare("SELECT * FROM vn_accounts WHERE clerk_user_id = ? LIMIT 1").bind(identity.clerkUserId).first();
    if (account) {
      const emailOwner = await db.prepare("SELECT account_id FROM vn_accounts WHERE email = ? COLLATE NOCASE AND account_id <> ? LIMIT 1").bind(email, account.account_id).first();
      if (emailOwner) throw new AppError("This verified email is already linked to another VN SHOP account. Contact support to merge accounts safely.", 409);
    }
  }
  // Never infer ownership from editable profile or order-form email fields.
  // Only a verified immutable Clerk subject may identify a legacy account.
  const legacyUserId = identity.clerkUserId || null;
  const now = nowISO();
  if (!account) {
    const accountId = randomId("vn_");
    await db.prepare(`INSERT OR IGNORE INTO vn_accounts (account_id,email,clerk_user_id,role,created_at,updated_at) VALUES (?,?,?,'customer',?,?)`)
      .bind(accountId, email, legacyUserId, now, now).run();
    account = await db.prepare("SELECT * FROM vn_accounts WHERE email = ? COLLATE NOCASE LIMIT 1").bind(email).first();
    if (!account && identity.clerkUserId) account = await db.prepare("SELECT * FROM vn_accounts WHERE clerk_user_id = ? LIMIT 1").bind(identity.clerkUserId).first();
    if (!account) throw new AppError("Unable to establish your VN SHOP account. Please retry sign-in.",503);
  } else if (identity.clerkUserId && account.clerk_user_id !== identity.clerkUserId) {
    await db.prepare("UPDATE vn_accounts SET clerk_user_id = ?, email = ?, updated_at = ? WHERE account_id = ?")
      .bind(identity.clerkUserId, email, now, account.account_id).run();
  } else if (account.email !== email) {
    await db.prepare("UPDATE vn_accounts SET email = ?, updated_at = ? WHERE account_id = ?")
      .bind(email, now, account.account_id).run();
  }
  if (legacyUserId) await migrateLegacyAccount(db, legacyUserId, account.account_id);
  await ensureProfile(db, account.account_id, { email, first_name: identity.firstName, last_name: identity.lastName });
  const columns = await getColumns(db, "customer_profiles");
  const updates = ["email", "first_name", "last_name"].filter(field => columns.includes(field) && identity[field === "email" ? "email" : field === "first_name" ? "firstName" : "lastName"]);
  if (updates.length) await db.prepare(`UPDATE customer_profiles SET ${updates.map(field => `${field} = ?`).join(", ")}, updated_at = ? WHERE user_id = ?`)
    .bind(...updates.map(field => field === "email" ? email : identity[field === "first_name" ? "firstName" : "lastName"]), now, account.account_id).run();
  if (ADMIN_EMAILS.has(email)) await db.prepare("UPDATE vn_accounts SET role = 'admin', updated_at = ? WHERE account_id = ?").bind(now, account.account_id).run();
  return { userId: account.account_id, email, isAdmin: ADMIN_EMAILS.has(email) || account.role === "admin", firstName: identity.firstName || "", lastName: identity.lastName || "" };
}

async function readBody(request) {
  const contentLength = Number(
    request.headers.get("Content-Length") || 0
  );

  if (contentLength > MAX_BODY_SIZE) {
    throw new AppError("Request body is too large.",413);
  }

  const bodyText = await request.text();

  if (new TextEncoder().encode(bodyText).byteLength > MAX_BODY_SIZE) {
    throw new AppError("Request body is too large.",413);
  }

  if (!bodyText.trim()) return {};

  let parsed;
  try {
    parsed = JSON.parse(bodyText);
  } catch {
    throw new AppError("Invalid JSON body.",400);
  }
  if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) throw new AppError("The request body must be a JSON object.",400);
  return parsed;
}

async function getColumns(db, tableName) {
  if (!/^[a-zA-Z0-9_]+$/.test(tableName)) throw new AppError("Invalid schema table.", 500);
  if (columnsCache.has(tableName)) return columnsCache.get(tableName);
  const result = await db.prepare(`PRAGMA table_info(${tableName})`).all();
  const columns = (result.results || []).map(column => column.name);
  columnsCache.set(tableName, columns);
  return columns;
}

async function ensureColumn(db, tableName, columnName, definition) {
  const columns = await getColumns(db, tableName);
  if (!columns.includes(columnName)) {
    await db.prepare(`ALTER TABLE ${tableName} ADD COLUMN ${columnName} ${definition}`).run();
    columnsCache.delete(tableName);
  }
}

async function dropColumnIfExists(db, tableName, columnName) {
  const columns = await getColumns(db, tableName);
  if (!columns.includes(columnName)) return;
  await db.prepare(`ALTER TABLE ${tableName} DROP COLUMN ${columnName}`).run();
  columnsCache.delete(tableName);
}

