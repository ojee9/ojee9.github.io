      VALUES (?,?,NULL,'Received',?,'Admin offline settlement',?)`).bind(randomId("ose_"),id,userId,timestamp)
  ];
  try {
    await db.batch(statements);
  } catch(err) {
    await db.prepare(`DELETE FROM payment_reference_registry WHERE order_id=?`).bind(id).run();
    if(requestKey) {
      const existing=await db.prepare(`SELECT * FROM customer_orders WHERE user_id=? AND request_key=? LIMIT 1`).bind(userId,requestKey).first();
