      db.prepare(`ALTER TABLE admin_order_code_registry_next RENAME TO admin_order_code_registry`)
    ]);
  }
  const maxAdminCode = await db.prepare(`SELECT COALESCE(MAX(code_number),0) AS n FROM admin_order_code_registry`).first();
  await db.prepare(`INSERT INTO admin_order_code_sequence (id,next_number) VALUES (1,?) ON CONFLICT(id) DO UPDATE SET next_number=MAX(admin_order_code_sequence.next_number,excluded.next_number)`).bind(Number(maxAdminCode?.n || 0)+1).run();
  const maxCustomerCode = await db.prepare(`SELECT COALESCE(MAX(CAST(SUBSTR(vn_code,4) AS INTEGER)),0) AS n FROM customer_orders WHERE SUBSTR(vn_code,1,3)=?`).bind("VN-").first();
  await db.prepare(`INSERT INTO customer_order_code_sequence (id,next_number) VALUES (1,?) ON CONFLICT(id) DO UPDATE SET next_number=MAX(customer_order_code_sequence.next_number,excluded.next_number)`).bind(Number(maxCustomerCode?.n || 0)+1).run();

  await ensureColumn(db, "admin_order_queue", "request_key", "TEXT");
  await db.prepare(`CREATE TABLE IF NOT EXISTS payment_reference_registry (payment_number TEXT PRIMARY KEY, order_id TEXT NOT NULL, created_at TEXT NOT NULL)`).run();
