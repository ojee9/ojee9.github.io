  // One-time rebuild of the legacy 1..99 registry, preserving all allocated codes.
  const registryDefinition = await db.prepare(`SELECT sql FROM sqlite_master WHERE type='table' AND name='admin_order_code_registry' LIMIT 1`).first();
  if (String(registryDefinition?.sql || "").includes("BETWEEN 1 AND 99")) {
    await db.batch([
      db.prepare(`CREATE TABLE IF NOT EXISTS admin_order_code_registry_next (code_number INTEGER PRIMARY KEY CHECK(code_number >= 1), admin_order_id TEXT NOT NULL UNIQUE, created_at TEXT NOT NULL)`),
