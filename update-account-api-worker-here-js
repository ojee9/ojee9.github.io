async function ensureProfile(db, userId, claims = {}) {
  const existing = await db.prepare(`
    SELECT *
    FROM customer_profiles
    WHERE user_id = ?
    LIMIT 1
  `).bind(userId).first();

  if (existing) return existing;

  const columns = await getColumns(db, "customer_profiles");

  const values = {
    user_id: userId,
    email: normalizeEmail(
      claims.email || claims.email_address || ""
    ),
    created_at: nowISO(),
    updated_at: nowISO()
  };

  const selectedColumns = Object.keys(values).filter(
    column => columns.includes(column)
  );

  const placeholders = selectedColumns.map(() => "?").join(", ");

  await db.prepare(`
    INSERT OR IGNORE INTO customer_profiles (
      ${selectedColumns.join(", ")}
    )
    VALUES (${placeholders})
  `).bind(
    ...selectedColumns.map(column => values[column])
  ).run();

  return await db.prepare(`
    SELECT *
    FROM customer_profiles
    WHERE user_id = ?
    LIMIT 1
  `).bind(userId).first();
}

