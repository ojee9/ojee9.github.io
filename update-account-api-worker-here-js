    JOIN customer_returns r ON r.id=ri.return_id
    WHERE lower(r.status) IN ('pending','accepted','return process','returned')
  `).bind(nowISO()).run();

  const drafts=await db.prepare(`SELECT * FROM admin_order_queue`).all();
  for(const draft of drafts.results||[]) {
    if (String(draft.order_number||"").startsWith("DRAFT-") || String(draft.vn_code||"").startsWith("DRAFT-")) {
      const identifiers=await reserveAdminIdentifiers(db,draft.id,draft.created_at||nowISO());
      const paymentNumber=draft.payment_number||await generatePaymentNumber(db,draft.id);
      const orderObject=parseJSON(draft.order_json,{});
      orderObject.orderNumber=identifiers.orderNumber;
