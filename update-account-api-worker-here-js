function corsHeaders(request) {
  const origin = request.headers.get("Origin") || "";

  return {
    "Access-Control-Allow-Origin":
      origin === ALLOWED_ORIGIN ? origin : ALLOWED_ORIGIN,
    "Access-Control-Allow-Methods":
      "GET, POST, PUT, PATCH, DELETE, OPTIONS",
    "Access-Control-Allow-Headers":
      "Authorization, Content-Type",
    "Access-Control-Max-Age": "86400",
    "Vary": "Origin"
  };
}

function withCors(response, request) {
  const headers = new Headers(response.headers);

  for (const [key, value] of Object.entries(corsHeaders(request))) {
    headers.set(key, value);
  }

  return new Response(response.body, {
    status: response.status,
    statusText: response.statusText,
    headers
  });
}

function getPathSegments(pathname) {
  return pathname
    .split("/")
    .filter(Boolean)
    .map(segment => decodeURIComponent(segment));
}

async function handleRequest(request, env) {
  if (!env.DB) {
    return error("Database is not configured.", 500);
  }

  const requestOrigin=request.headers.get("Origin") || "";
  if (requestOrigin && requestOrigin !== ALLOWED_ORIGIN) return error("Origin not allowed.",403);
  if (request.method.toUpperCase() === "OPTIONS") {
    return new Response(null, {
      status: 204,
      headers: corsHeaders(request)
    });
  }

  await ensureSchema(env.DB);

  const url = new URL(request.url);
  const method = request.method.toUpperCase();
  const path = url.pathname.replace(/\/+$/, "") || "/";
  const segments = getPathSegments(path);

  if (path === "/api/health" && method === "GET") {
    return json({
      status: "ok",
      service: "vn-shop-account-api",
      timestamp: nowISO()
    });
  }

  if (path === "/api/operations/auth" && method === "POST") {
    const body = await readBody(request);
    const supplied = typeof body.password === "string" ? body.password : "";

    if (!supplied || supplied.length > 512) {
      return error("A valid administrator password is required.", 400);
    }

    const ip = request.headers.get("CF-Connecting-IP") || "unknown";
    const attemptKey = await sha256(ip);
    const attempt = await env.DB.prepare(`
      SELECT failures, window_started_at, locked_until
      FROM vn_operation_login_attempts
      WHERE attempt_key = ?
    `).bind(attemptKey).first();

    if (attempt?.locked_until && Date.parse(attempt.locked_until) > Date.now()) {
      return error("Too many login attempts. Try again later.", 429);
    }

    let credentials;
    try {
      credentials = parseOperationsAdminCredentials(env.OPERATIONS_ADMIN_CREDENTIALS);
    } catch (parseError) {
      if (parseError instanceof AppError) {
        return error(parseError.message, parseError.status);
      }
      console.error("Operations credentials could not be loaded:", parseError);
      return error("Operations credentials are misconfigured.", 503);
    }

    let match = null;
    for (const credential of credentials) {
      if (await constantTimeStringEqual(credential.password, supplied)) {
        match = credential;
      }
    }

    if (!match) {
      const windowIsCurrent =
        attempt?.window_started_at &&
        Date.now() - Date.parse(attempt.window_started_at) < 15 * 60 * 1000;
      const start = windowIsCurrent ? attempt.window_started_at : nowISO();
      const failures = (windowIsCurrent ? Number(attempt.failures || 0) : 0) + 1;
      const locked = failures >= 5
        ? new Date(Date.now() + 15 * 60 * 1000).toISOString()
        : null;

      await env.DB.prepare(`
        INSERT INTO vn_operation_login_attempts
          (attempt_key, failures, window_started_at, locked_until)
        VALUES (?, ?, ?, ?)
        ON CONFLICT(attempt_key) DO UPDATE SET
          failures = excluded.failures,
          window_started_at = excluded.window_started_at,
          locked_until = excluded.locked_until
      `).bind(attemptKey, failures, start, locked).run();

      return error("Incorrect administrator password.", 401);
    }

    await env.DB.prepare(`
      DELETE FROM vn_operation_login_attempts
      WHERE attempt_key = ?
    `).bind(attemptKey).run();

    await env.DB.prepare(`
      DELETE FROM vn_operation_sessions
      WHERE expires_at <= ?
    `).bind(nowISO()).run();

    const session = await createOperationSession(env.DB, match.id);
    return json({
      success: true,
      token: session.token,
      expiresAt: session.expiresAt,
      operator: match.label
    });
  }

  if (path === "/api/operations/admin-orders" && method === "POST") {
    const claims = await authenticateWorkerSession(request, env.DB);
    if (!claims || !(await isAdmin(env, claims.sub))) return error("Administrator account required.", 403);
    const body = await readBody(request);
    try { const order = await prepareAdminOrder(env.DB, claims.sub, body); return json({ success: true, order }, 201); }
    catch (err) { if(err instanceof AppError) return error(err.message,err.status); console.error("Admin order queue failed:",err); return error("Unable to queue admin order.",500); }
  }

  if (path.startsWith("/api/operations/") && path !== "/api/operations/auth") {
    const operationSession=await authenticateOperationSession(request,env.DB);
    if (!operationSession) return error("Operations session required.", 401);
    const operationActor=operationSession.actorId;
    if (path === "/api/operations/orders" && method === "GET") return json({ success: true, orders: await listOperationOrders(env.DB) });
    if (path === "/api/operations/admin-orders" && method === "GET") return json({ success: true, orders: await listOperationAdminOrders(env.DB) });
    if (path === "/api/operations/returns" && method === "GET") return json({ success: true, returns: await listOperationReturns(env.DB) });
    if (path === "/api/operations/issues" && method === "GET") return json({ success: true, issues: await listOperationIssues(env.DB) });

    if (segments[2] === "orders" && segments[3] && segments[4] === "status" && segments.length === 5 && method === "PATCH") {
      const body = await readBody(request);
      const requested = validText(body.status, 40).toLowerCase();
      const record = await env.DB.prepare(`SELECT id,order_status FROM customer_orders WHERE id=? AND COALESCE(is_admin_order,0)=0 LIMIT 1`).bind(segments[3]).first();
      if (!record) return error("Order not found.", 404);
      const current = String(record.order_status || "Received").toLowerCase();
      const allowed = { received:["preparing","cancelled"], preparing:["delivering","cancelled"], delivering:["delivered","cancelled"] };
      if (!(allowed[current] || []).includes(requested)) return error("Invalid order status transition.", 409);
      const reason = validText(body.cancellation_reason || body.reason, 500);
      const cancellationReasons=["High workload","Out of stock","Suspicious purchase","Address or delivery information issue","Product unavailable","Payment could not be verified","Customer request","Other"];
      if (requested === "cancelled" && !cancellationReasons.includes(reason)) return error("Select a valid cancellation reason.",400);
      const next = requested === "preparing" ? "Preparing" : requested === "delivering" ? "Delivering" : requested === "delivered" ? "Delivered" : "Cancelled";
      const timestamp = nowISO();
      await env.DB.batch([
        env.DB.prepare(`UPDATE customer_orders SET order_status=?,updated_at=?,delivered_at=CASE WHEN ?='Delivered' THEN ? ELSE delivered_at END WHERE id=?`).bind(next,timestamp,next,timestamp,segments[3]),
        env.DB.prepare(`INSERT INTO order_status_history (id,order_id,from_status,to_status,actor_id,reason,created_at) VALUES (?,?,?,?,?,?,?)`).bind(randomId("osh_"),segments[3],record.order_status,next,operationActor,reason || null,timestamp),
        env.DB.prepare(`INSERT INTO order_status_events (id,order_id,from_status,to_status,actor_id,reason,created_at) VALUES (?,?,?,?,?,?,?)`).bind(randomId("ose_"),segments[3],record.order_status,next,operationActor,reason || null,timestamp)
      ]);
      return json({ success: true, status: next });
    }

    if (segments[2] === "admin-orders" && segments[3] && segments[4] === "status" && segments.length === 5 && method === "PATCH") {
      const body = await readBody(request);
      try { const ok = await finalizeQueuedAdminOrder(env.DB, segments[3], body.status, operationActor); return ok ? json({ success: true }) : error("Admin order not found.", 404); }
      catch (err) { if(err instanceof AppError) return error(err.message,err.status); console.error("Admin order finalization failed:",err); return error("Unable to finalize admin order.",500); }
    }

    if (segments[2] === "returns" && segments[3] && segments.length === 4 && method === "PATCH") {
      const body = await readBody(request);
      const record = await env.DB.prepare(`SELECT id,status FROM customer_returns WHERE id=? LIMIT 1`).bind(segments[3]).first();
      if (!record) return error("Return request not found.", 404);
      const requested = validText(body.status,40).toLowerCase();
      const current = String(record.status || "pending").toLowerCase();
      const allowed = { pending:["return process","rejected"], accepted:["return process","rejected"], "return process":["returned"] };
      if (!(allowed[current] || []).includes(requested)) return error("Invalid return status transition.", 409);
      const next = requested === "return process" ? "Return Process" : requested === "returned" ? "Returned" : "Rejected";
      const timestamp = nowISO();
      await env.DB.batch([
        env.DB.prepare(`UPDATE customer_returns SET status=?,updated_at=?,reviewed_at=?,reviewed_by=?,admin_note=? WHERE id=?`).bind(next,timestamp,timestamp,operationActor,validText(body.admin_note || body.note,3000),segments[3]),
        env.DB.prepare(`INSERT INTO return_status_history (id,return_id,from_status,to_status,actor_id,note,created_at) VALUES (?,?,?,?,?,?,?)`).bind(randomId("rsh_"),segments[3],record.status,next,operationActor,validText(body.admin_note || body.note,3000) || null,timestamp)
      ]);
      return json({ success: true, status: next });
    }

    if (segments[2] === "issues" && segments[3] && segments.length === 4 && method === "PATCH") {
      const body = await readBody(request);
      const record = await env.DB.prepare(`SELECT id,status FROM issues WHERE id=? LIMIT 1`).bind(segments[3]).first();
      if (!record) return error("Customer report not found.", 404);
      const requested = validText(body.status,40).toLowerCase();
      const current = String(record.status || "open").toLowerCase();
      if (!((current === "open" && requested === "in progress") || (current === "in progress" && requested === "resolved"))) return error("Invalid report status transition.", 409);
      const timestamp = nowISO();
      const resolution=validText(body.resolution,4000);
      if(requested==="resolved" && !resolution) return error("A resolution note is required before closing a report.",400);
      await env.DB.batch([
        env.DB.prepare(`UPDATE issues SET status=?,updated_at=?,processing_started_at=CASE WHEN ?='in progress' THEN ? ELSE processing_started_at END,resolved_at=CASE WHEN ?='resolved' THEN ? ELSE resolved_at END,resolution=COALESCE(?,resolution) WHERE id=?`)
          .bind(requested,timestamp,requested,timestamp,requested,timestamp,resolution || null,segments[3]),
        env.DB.prepare(`INSERT INTO issue_status_history (id,issue_id,from_status,to_status,actor_id,resolution,created_at) VALUES (?,?,?,?,?,?,?)`)
          .bind(randomId("ish_"),segments[3],record.status,requested,operationActor,resolution||null,timestamp)
      ]);
      return json({ success: true, status: requested });
    }
    if (segments[2] === "admin-orders" && segments[3] && segments[4] === "payment" && segments.length === 5 && method === "PATCH") {
      const body=await readBody(request), status=validText(body.payment_status ?? body.status,30).toLowerCase();
      if (!["paid","unpaid","pending"].includes(status)) return error("Invalid admin order payment status.",400);
      const paymentNumber=validText(body.payment_number ?? body.paymentNumber,120);
      if (status==="paid" && !paymentNumber) return error("A payment number is required when marking an admin order as paid.",400);
      let row=await env.DB.prepare(`SELECT id,payment_status FROM admin_orders WHERE id=?`).bind(segments[3]).first();
      let targetTable="admin_orders";
      if(!row){ row=await env.DB.prepare(`SELECT id,payment_status FROM admin_order_queue WHERE id=?`).bind(segments[3]).first(); targetTable="admin_order_queue"; }
      if(!row) return error("Admin order not found.",404);
      const timestamp=nowISO(), storedStatus=status==="paid"?"Paid":status==="unpaid"?"Unpaid":"Pending";
      await env.DB.batch([
        env.DB.prepare(`UPDATE ${targetTable} SET payment_status=?,payment_number=?,updated_at=? WHERE id=?`).bind(storedStatus,status==="paid"?paymentNumber:null,timestamp,segments[3]),
        env.DB.prepare(`INSERT INTO admin_order_events (id,admin_order_id,event_type,actor_id,details_json,created_at) VALUES (?,?,?,?,?,?)`).bind(randomId("aoe_"),segments[3],"payment_status",operationActor,JSON.stringify({from:row.payment_status,to:status,payment_number:status==="paid"?paymentNumber:null}),timestamp)
      ]);
      return json({success:true,payment_status:status,payment_number:status==="paid"?paymentNumber:null});
    }
    if (segments[2] === "admin-orders" && segments[3] && segments.length === 4 && method === "DELETE") {
      const row=await env.DB.prepare(`SELECT id,order_number,vn_code FROM admin_orders WHERE id=?`).bind(segments[3]).first();
      if(!row) return error("Admin order not found.",404);
      const timestamp=nowISO();
      await env.DB.batch([
        env.DB.prepare(`INSERT INTO admin_order_events (id,admin_order_id,event_type,actor_id,details_json,created_at) VALUES (?,?,?,?,?,?)`).bind(randomId("aoe_"),row.id,"deleted",operationActor,JSON.stringify({order_number:row.order_number,vn_code:row.vn_code}),timestamp),
        env.DB.prepare(`DELETE FROM admin_orders WHERE id=?`).bind(row.id)
      ]);
      return json({success:true});
    }
    if (path === "/api/operations/history" && method === "GET") {
      const limit=Math.min(200,Math.max(1,Number(url.searchParams.get("limit")||100)));
      const rows=await env.DB.prepare(`SELECT id,order_id AS record_id,'order_status' AS event_type,from_status,to_status,actor_id,reason AS details,created_at FROM order_status_history UNION ALL SELECT id,return_id AS record_id,'return_status' AS event_type,from_status,to_status,actor_id,note AS details,created_at FROM return_status_history ORDER BY created_at DESC LIMIT ?`).bind(limit).all();
      const adminEvents=await env.DB.prepare(`SELECT id,admin_order_id AS record_id,event_type,actor_id,details_json AS details,created_at FROM admin_order_events ORDER BY created_at DESC LIMIT ?`).bind(limit).all();
      const issueEvents=await env.DB.prepare(`SELECT id,issue_id AS record_id,'issue_status' AS event_type,from_status,to_status,actor_id,resolution AS details,created_at FROM issue_status_history ORDER BY created_at DESC LIMIT ?`).bind(limit).all();
      return json({success:true,events:[...(rows.results||[]),...(adminEvents.results||[]),...(issueEvents.results||[])].sort((a,b)=>String(b.created_at).localeCompare(String(a.created_at))).slice(0,limit)});
    }
    return error("Operations endpoint not found.", 404);
  }

  if (path === "/api/auth/exchange" && method === "POST") {
    const claims = await authenticateClerk(request);
    if (!claims) return error("Authentication failed.", 401);
    try {
      const identity = await getVerifiedClerkIdentity(env, claims);
      const account = await resolveVNAccount(env.DB, identity);
      const session = await createSession(env.DB, account.userId);
      return json({ success: true, token: session.token, expiresAt: session.expiresAt, userId: account.userId, email: account.email, firstName: account.firstName, lastName: account.lastName, isAdmin: account.isAdmin, is_admin: account.isAdmin });
    } catch (err) { console.error("Shop account exchange failed:",err); return error("Could not establish your VN SHOP account.",401); }
  }

  if (path === "/api/auth/shop-exchange" && method === "POST") {
    try {
      const body = await readBody(request);
      const identity = await getVerifiedShopIdentity(body.sessionToken);
      const account = await resolveVNAccount(env.DB, identity);
      const session = await createSession(env.DB, account.userId);
      return json({ success: true, token: session.token, expiresAt: session.expiresAt, userId: account.userId, email: account.email, firstName: account.firstName, lastName: account.lastName, isAdmin: account.isAdmin, is_admin: account.isAdmin });
    } catch (err) { console.error("Shop account exchange failed:",err); return error("Could not establish your VN SHOP account.",401); }
  }

  if (path === "/api/auth/logout" && method === "POST") {
    const token = getBearerToken(request);

    if (token) {
      const tokenHash = await sha256(token);

      await env.DB.prepare(`
        DELETE FROM customer_sessions
        WHERE token_hash = ?
      `).bind(tokenHash).run();
    }

    return json({ success: true });
  }

  const claims = await authenticateRequest(request, env.DB);

  if (!claims) {
    return error("Authentication required.", 401);
  }

  const userId = claims.sub;

  if (!userId || !userId.startsWith("vn_")) {
    return error("Invalid VN SHOP account session.", 401);
  }

  const admin = await isAdmin(env, userId);

  await ensureProfile(env.DB, userId, claims);

  if (path === "/api/account" && method === "GET") {
    const profile = await env.DB.prepare(`
      SELECT *
      FROM customer_profiles
      WHERE user_id = ?
      LIMIT 1
    `).bind(userId).first();

    const addresses = await getAddresses(env.DB, userId);

    return json({
      success: true,
      profile: profileResponse(profile, userId, admin),
      addresses,
      isAdmin: admin,
      is_admin: admin
    });
  }

  if (path === "/api/profile" && method === "PUT") {
    const body = await readBody(request);

    const profile = await updateProfile(
      env.DB,
      userId,
      body
    );

    return json({
      success: true,
      profile: profileResponse(profile, userId, admin)
    });
  }

  if (path === "/api/addresses" && method === "GET") {
    return json({
      success: true,
      addresses: await getAddresses(env.DB, userId)
    });
  }

  if (path === "/api/addresses" && method === "POST") {
    const body = await readBody(request);

    const address = await addAddress(
      env.DB,
      userId,
      body
    );

    return json({
      success: true,
      address
    }, 201);
  }

  if (
    segments[0] === "api" &&
    segments[1] === "addresses" &&
    segments[2] &&
    segments[3] === "default" &&
    method === "PATCH"
  ) {
    const success = await setDefaultAddress(
      env.DB,
      userId,
      segments[2]
    );

    if (!success) {
      return error("Unable to set default address.", 404);
    }

    return json({ success: true });
  }

  if (
    segments[0] === "api" &&
    segments[1] === "addresses" &&
    segments[2] &&
    segments.length === 3 &&
    method === "DELETE"
  ) {
    const success = await deleteAddress(
      env.DB,
      userId,
      segments[2]
    );

    if (!success) {
      return error("Address not found.", 404);
    }

    return json({ success: true });
  }

  if (path === "/api/orders" && method === "GET") {
    return json({
      success: true,
      orders: await listOrders(env.DB, userId, admin)
    });
  }

  if (path === "/api/orders" && method === "POST") {
    if (!admin) {
      return error("Order registration requires payment confirmation.", 403);
    }

    const body = await readBody(request);

    try {
      const order = await prepareAdminOrder(env.DB, userId, body);

      return json({
        success: true,
        order
      }, 200);
    } catch (err) {
      if(err instanceof AppError) return error(err.message,err.status);
      console.error("Admin order draft failed:",err);
      return error("Unable to prepare order.",500);
    }
  }

  if (path === "/api/admin-orders" && method === "GET") {
    if (!admin) {
      return error("Access denied.", 403);
    }

    return json({
      success: true,
      orders: await listAdminOrders(env.DB)
    });
  }

  if (path === "/api/admin-orders" && method === "POST") {
    if (!admin) {
      return error("Access denied.", 403);
    }

    const body = await readBody(request);

    try {
      const order = await prepareAdminOrder(env.DB, userId, body);
      return json({ success: true, order }, 201);
    } catch (err) {
      if(err instanceof AppError) return error(err.message,err.status);
      console.error("Admin order draft failed:",err);
      return error("Unable to queue admin order.",500);
    }
  }

  if (
    segments[0] === "api" &&
    segments[1] === "admin-orders" &&
    segments[2] &&
    segments.length === 3 &&
    method === "PATCH"
  ) {
    if (!admin) {
      return error("Access denied.", 403);
    }

    const body = await readBody(request);

    try {
      const success = await finalizeQueuedAdminOrder(
        env.DB,
        segments[2],
        body.status || body.orderStatus,
        userId
      );

      if (!success) {
        return error("Order not found.", 404);
      }

      return json({ success: true });
    } catch (err) {
      if(err instanceof AppError) return error(err.message,err.status);
      console.error("Order status update failed:",err);
      return error("Unable to update order.",500);
    }
  }

  if (
    segments[0] === "api" &&
    segments[1] === "orders" &&
    segments[2] &&
    segments[3] === "items" &&
    segments[4] &&
    method === "DELETE"
  ) {
    if (!admin) {
      return error("Access denied.", 403);
    }

    const success = await removeOrderItem(
      env.DB,
      userId,
      segments[2],
      segments[4]
    );

    if (!success) {
      return error("Order item not found.", 404);
    }

    return json({ success: true });
  }

  if (
    segments[0] === "api" &&
    segments[1] === "orders" &&
    segments[2] &&
    segments.length === 3 &&
    method === "PATCH"
  ) {
    if (!admin) {
      return error("Access denied.", 403);
    }

    const body = await readBody(request);

    try {
      const success = await updateOrderStatus(
        env.DB,
        segments[2],
        body,
        userId
      );

      if (!success) {
        return error("Order not found.", 404);
      }

      return json({ success: true });
    } catch (err) {
      if(err instanceof AppError) return error(err.message,err.status);
      console.error("Order status update failed:",err);
      return error("Unable to update order.",500);
    }
  }

  if (path === "/api/issues" && method === "GET") {
    const result = await env.DB.prepare(`SELECT * FROM issues WHERE user_id = ? ORDER BY created_at DESC`).bind(userId).all();
    return json({ success: true, issues: result.results || [] });
  }

  if (path === "/api/issues" && method === "POST") {
    const body = await readBody(request);
    const description = validText(body.description || body.message, 3000);
    const issueType = validText(body.issue_type || body.type, 40).toLowerCase();
    const allowedIssueTypes = ["delivery","product","payment","account","other"];
    if (!allowedIssueTypes.includes(issueType) || description.length < 10) return error("Select a valid issue type and describe the issue in at least 10 characters.", 400);
    const orderId = validText(body.order_id || body.orderId, 150);
    if (!orderId) return error("Select the related order.", 400);
    const order = await getOrderForUser(env.DB, userId, orderId);
    if (!order) return error("Order not found.", 404);
    const id = randomId("issue_");
    const timestamp = nowISO();
    await env.DB.prepare(`INSERT INTO issues (id,user_id,order_id,order_number,issue_type,description,status,created_at,updated_at) VALUES (?,?,?,?,?,?,'open',?,?)`)
      .bind(id,userId,orderId || null,order?.order_number || null,issueType,description,timestamp,timestamp).run();
    return json({ success: true, issue: { id, order_id: orderId || null, order_number: order?.order_number || null, description, status: "open", created_at: timestamp, updated_at: timestamp } }, 201);
  }

  if (path === "/api/returns" && method === "GET") {
    return json({
      success: true,
      returns: await listReturns(env.DB, userId, admin)
    });
  }

  if (path === "/api/returns" && method === "POST") {
    if (admin) {
      return error("Return request is unavailable for this account.", 403);
    }

    const body = await readBody(request);

    try {
      const returnRecord = await createReturn(
        env.DB,
        userId,
        body
      );

      return json({
        success: true,
        return: returnRecord
      }, 201);
    } catch (err) {
      if(err instanceof AppError) return error(err.message,err.status);
      console.error("Return request creation failed:",err);
      return error("Unable to create return request.",500);
    }
  }

  if (
    segments[0] === "api" &&
    segments[1] === "returns" &&
    segments[2] &&
    segments.length === 3 &&
    method === "PATCH"
  ) {
    if (!admin) {
      return error("Access denied.", 403);
    }

    const body = await readBody(request);

    try {
      const success = await updateReturnStatus(
        env.DB,
        userId,
        segments[2],
        body
      );

      if (!success) {
        return error("Return request not found.", 404);
      }

      return json({ success: true });
    } catch (err) {
      if(err instanceof AppError) return error(err.message,err.status);
      console.error("Return status update failed:",err);
      return error("Unable to update return.",500);
    }
  }

  return error("Endpoint not found.", 404);
}

export default {
  async fetch(request, env) {
    try {
      const response = await handleRequest(request, env);
      return withCors(response, request);
    } catch (err) {
      if (err instanceof AppError) return withCors(error(err.message,err.status),request);
      console.error("VN SHOP account Worker failure:",err);
      return withCors(error("An unexpected server error occurred. Please try again.",500),request);
    }
  }
};
