async function updateReturnStatus(db, adminId, returnId, body) {
  const requested=validText(body.status,40).toLowerCase();
  const canonical={accepted:"Accepted",rejected:"Rejected","return process":"Return Process",returned:"Returned"};
  const status=canonical[requested];
  if (!status) throw new AppError("Invalid return status.",400);
  const record=await db.prepare(`SELECT id,status FROM customer_returns WHERE id=? LIMIT 1`).bind(returnId).first();
  if (!record) return false;
  const current=String(record.status||"Pending");
  if (current===status) return true;
  const allowed={Pending:["Accepted","Return Process","Rejected"],Accepted:["Return Process","Rejected"],"Return Process":["Returned"]};
  if (!(allowed[current]||[]).includes(status)) throw new AppError("Invalid return status transition.",409);
  const timestamp=nowISO(), note=validText(body.admin_note ?? body.adminNote,3000), historyId=randomId("rsh_");
  const results=await db.batch([
    db.prepare(`UPDATE customer_returns SET status=?,updated_at=?,reviewed_at=?,reviewed_by=?,admin_note=? WHERE id=? AND status=?`)
      .bind(status,timestamp,timestamp,adminId,note,returnId,current),
    db.prepare(`INSERT INTO return_status_history (id,return_id,from_status,to_status,actor_id,note,created_at) SELECT ?,?,?,?,?,?,? WHERE changes()=1`)
      .bind(historyId,returnId,current,status,adminId,note||null,timestamp),
    db.prepare(`UPDATE customer_return_item_claims SET status=? WHERE return_id=? AND EXISTS (SELECT 1 FROM return_status_history WHERE id=?)`)
      .bind(status,returnId,historyId),
    db.prepare(`DELETE FROM customer_return_item_claims WHERE return_id=? AND status='Rejected' AND EXISTS (SELECT 1 FROM return_status_history WHERE id=?)`)
      .bind(returnId,historyId)
  ]);
  if (!results?.[0]?.meta?.changes) throw new AppError("Return status changed before this update could be saved. Refresh and try again.",409);
  return true;
}





function removeRawControlCharactersInsideJsonStrings(value) {
  const source = String(value ?? "").replace(/^\\uFEFF/, "");
  let output = "";
  let insideString = false;
  let escaped = false;

  for (let index = 0; index < source.length; index++) {
    const character = source[index];
    const code = source.charCodeAt(index);

    if (insideString) {
      if (escaped) {
        output += character;
        escaped = false;
        continue;
      }

      if (character === "\\\\") {
        output += character;
        escaped = true;
        continue;
      }

      if (character === '"') {
        output += character;
        insideString = false;
        continue;
      }

      // Remove accidental raw control characters pasted into secret values.
      // Legal JSON whitespace outside strings remains untouched.
      if (code < 0x20 || code === 0x7f) continue;

      output += character;
      continue;
    }

    output += character;
    if (character === '"') insideString = true;
  }

  return output.trim();
}

function parseOperationsAdminCredentials(rawValue) {
  const raw = String(rawValue ?? "").trim();
  if (!raw) {
    throw new AppError("Operations credentials are not configured.", 503);
  }

  let parsed;
  try {
    parsed = JSON.parse(removeRawControlCharactersInsideJsonStrings(raw));
  } catch (parseError) {
    console.error(
      "OPERATIONS_ADMIN_CREDENTIALS JSON parse failed:",
      parseError instanceof Error ? parseError.message : String(parseError)
    );
    throw new AppError("Operations credentials are misconfigured.", 503);
  }

  if (!Array.isArray(parsed) || parsed.length === 0) {
    throw new AppError("Operations credentials are not configured.", 503);
  }

  const ids = new Set();
  const passwords = new Set();

  const credentials = parsed.map(entry => {
    const id = typeof entry?.id === "string" ? entry.id.trim() : "";
    const password = typeof entry?.password === "string" ? entry.password : "";

    if (!id || password.length < 24 || password.length > 512) {
      throw new AppError(
        "Each operator must have an id and a password between 24 and 512 characters.",
        503
      );
    }

    if (ids.has(id) || passwords.has(password)) {
      throw new AppError(
        "Each operator must have a unique id and a unique password.",
        503
      );
    }

    ids.add(id);
    passwords.add(password);

    return {
      id,
      password,
      label: validText(entry.label || id, 80)
    };
  });

  return credentials;
}

async function constantTimeStringEqual(leftValue, rightValue) {
  const encoder = new TextEncoder();
  const [leftDigest, rightDigest] = await Promise.all([
    crypto.subtle.digest("SHA-256", encoder.encode(String(leftValue))),
    crypto.subtle.digest("SHA-256", encoder.encode(String(rightValue)))
  ]);

  const left = new Uint8Array(leftDigest);
  const right = new Uint8Array(rightDigest);
  let difference = 0;

  for (let index = 0; index < left.length; index++) {
    difference |= left[index] ^ right[index];
  }

  return difference === 0;
}

