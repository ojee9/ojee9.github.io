}

async function generateUniqueCustomerCode(db) {
  const sequence = await db.prepare(`
    SELECT MAX(CAST(SUBSTR(vn_code, 4) AS INTEGER)) AS last_code
    FROM customer_orders
    WHERE vn_code GLOB 'VN-[0-9]*'
  `).first();

  const nextNumber = Math.max(0, Number(sequence?.last_code || 0)) + 1;

  if (nextNumber <= 999) {
    return `VN-${String(nextNumber).padStart(3, "0")}`;
  }

  return `VN-${String(nextNumber).padStart(4, "0")}`;
}

async function prepareAdminOrder(db, userId, body) {
  const orderInput = body.order || body;
  const order = normalizeOrderRecord(orderInput);
  order.createdAt = nowISO();
  const id = randomId("admin_queue_");
  const timestamp = nowISO();
  const draftNumber = `DRAFT-${id.slice(-12)}`;
  const serialized = serializeNormalizedOrder(order);
  const queueOrder = { ...order.originalOrder, orderNumber: null, vnCode: null, status: "received", orderStatus: "Received", paymentStatus: "Pending" };
  await db.prepare(`INSERT INTO admin_order_queue (
    id,user_id,order_number,vn_code,created_at,updated_at,status,customer_json,items_json,
    subtotal,shipping,taxes,total,currency,country_code,shipping_method,payment_method,payment_status,payment_number,order_json
  ) VALUES (?,?,?,?,?,?,'received',?,?,?,?,?,?,?,?,?,?,'Pending',NULL,?)`).bind(
    id,userId,draftNumber,draftNumber,order.createdAt,timestamp,
    JSON.stringify(order.customer),JSON.stringify(serialized.items),order.subtotal,order.shipping,order.taxes,
    order.total,order.currency,order.countryCode,order.shippingMethod,order.paymentMethod,JSON.stringify(queueOrder)
  ).run();
  return { id, orderNumber: null, vnCode: null, draftReference: draftNumber, createdAt: order.createdAt,
    customer: order.customer, items: serialized.items, subtotal: order.subtotal, shipping: order.shipping,
    taxes: order.taxes, total: order.total, currency: order.currency, countryCode: order.countryCode,
    shippingMethod: order.shippingMethod, paymentMethod: order.paymentMethod, status: "received",
    orderStatus: "Received", paymentStatus: "Pending", isAdminOrder: true,
    order: { ...order.originalOrder, orderNumber: null, vnCode: null, createdAt: order.createdAt } };
}



