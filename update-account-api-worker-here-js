async function authenticateOperationSession(request, db) {
  const token=getBearerToken(request); if(!token) return null;
  const tokenHash=await sha256(token);
  const row=await db.prepare(`SELECT id,actor_id,expires_at FROM vn_operation_sessions WHERE token_hash=? LIMIT 1`).bind(tokenHash).first();
  if(!row) return null;
