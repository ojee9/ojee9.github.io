async function generatePaymentNumber(db, orderId) {
  for (let attempt=0;attempt<8;attempt++) {
    const paymentNumber = "VN-PAY-" + new Date().toISOString().slice(0,10).replace(/-/g,"") + "-" + randomDigits(8);
    await db.prepare("INSERT OR IGNORE INTO payment_reference_registry (payment_number,order_id,created_at) VALUES (?,?,?)").bind(paymentNumber,orderId,nowISO()).run();
    const saved=await db.prepare("SELECT payment_number FROM payment_reference_registry WHERE order_id=? LIMIT 1").bind(orderId).first();
    if (saved?.payment_number) return saved.payment_number;
  }
  throw new AppError("Unable to generate a unique payment number.",503);
}

