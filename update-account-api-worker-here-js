async function updateProfile(db, userId, body) {
  const columns = await getColumns(db, "customer_profiles");
  const allowed = getAllowedProfileFields(columns);

  const mapping = {
    first_name: validText(body.first_name ?? body.firstName, 100),
    last_name: validText(body.last_name ?? body.lastName, 100),
    email: normalizeEmail(body.email),
    phone: validText(body.phone, 50),
    country: validText(body.country, 100),
    country_code: validText(body.country_code ?? body.countryCode, 5),
    marketing_consent:
      body.marketing_consent ?? body.marketingConsent ? 1 : 0,
    date_of_birth: validText(
      body.date_of_birth ?? body.dateOfBirth,
      30
    ),
    updated_at: nowISO()
  };

  const updates = allowed.filter(field => (
    Object.prototype.hasOwnProperty.call(body, field) ||
    (field === "first_name" && body.firstName !== undefined) ||
    (field === "last_name" && body.lastName !== undefined) ||
    (field === "country_code" && body.countryCode !== undefined) ||
    (field === "marketing_consent" && body.marketingConsent !== undefined) ||
    (field === "date_of_birth" && body.dateOfBirth !== undefined)
  ));

  if (!updates.includes("updated_at") && columns.includes("updated_at")) {
    updates.push("updated_at");
  }

  if (updates.length) {
    await db.prepare(`
      UPDATE customer_profiles
      SET ${updates.map(field => `${field} = ?`).join(", ")}
      WHERE user_id = ?
    `).bind(
      ...updates.map(field => mapping[field]),
      userId
    ).run();
  }

  return await db.prepare(`
    SELECT *
    FROM customer_profiles
    WHERE user_id = ?
    LIMIT 1
  `).bind(userId).first();
}

