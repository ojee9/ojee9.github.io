      VALUES (?,?,?,?,?,?,?,?,?,?,1)`)
      .bind(item.id,id,item.productId,item.title,item.variant,item.quantity,item.unitPrice,item.totalPrice,item.image,item.itemJson)),
    db.prepare(`INSERT INTO order_status_history(id,order_id,from_status,to_status,actor_id,reason,created_at)
