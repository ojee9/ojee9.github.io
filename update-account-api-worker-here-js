async function updateProfile(db, userId, body) {
  const columns = await getColumns(db, "customer_profiles");
  const allowed = getAllowedProfileFields(columns);

  const mapping = {
    first_name: validText(body.first_name ?? body.firstName, 100),
    last_name: validText(body.last_name ?? body.lastName, 100),
    email: normalizeEmail(body.email),
    phone: validText(body.phone, 50),
    country: validText(body.country, 100),
    country_code: validText(body.country_code ?? body.countryCode, 5),
    marketing_consent:
      body.marketing_consent ?? body.marketingConsent ? 1 : 0,
    date_of_birth: validText(
      body.date_of_birth ?? body.dateOfBirth,
      30
    ),
    updated_at: nowISO()
  };

  const updates = allowed.filter(field => (
    Object.prototype.hasOwnProperty.call(body, field) ||
    (field === "first_name" && body.firstName !== undefined) ||
    (field === "last_name" && body.lastName !== undefined) ||
    (field === "country_code" && body.countryCode !== undefined) ||
    (field === "marketing_consent" && body.marketingConsent !== undefined) ||
    (field === "date_of_birth" && body.dateOfBirth !== undefined)
  ));

  if (!updates.includes("updated_at") && columns.includes("updated_at")) {
    updates.push("updated_at");
  }

  if (updates.length) {
    await db.prepare(`
      UPDATE customer_profiles
      SET ${updates.map(field => `${field} = ?`).join(", ")}
      WHERE user_id = ?
    `).bind(
      ...updates.map(field => mapping[field]),
      userId
    ).run();
  }

  return await db.prepare(`
    SELECT *
    FROM customer_profiles
    WHERE user_id = ?
    LIMIT 1
  `).bind(userId).first();
}

async function addAddress(db, userId, body) {
  const countryCode=validText(body.country_code ?? body.countryCode,2).toUpperCase();
  const country=validText(body.country,100);
  const firstName=validText(body.first_name ?? body.firstName,100);
  const lastName=validText(body.last_name ?? body.lastName,100);
  const addressLine=validText(body.address_line_1 ?? body.addressLine1 ?? body.address,300);
  const city=validText(body.city,100);
  const postal=validText(body.postal_code ?? body.postalCode ?? body.postal,30);
  const phone=validText(body.phone,50);
  if (!/^[A-Z]{2}$/.test(countryCode) || !country) throw new AppError("Select a valid country and provide its two-letter country code.");
  if (!firstName || !lastName || !addressLine || !city || !postal || !phone) throw new AppError("First name, last name, street address, city, postal code, country, and phone are required.");
  const columns = await getColumns(db, "customer_addresses");
  const allowed = getAllowedAddressFields(columns);
  const id = randomId("addr_");
  const createdAt = nowISO();

  const mapping = {
    label: validText(body.label, 60),
    first_name: validText(body.first_name ?? body.firstName, 100),
    last_name: validText(body.last_name ?? body.lastName, 100),
    company: validText(body.company, 150),
    address: validText(body.address, 300),
    address_line_1: validText(
      body.address_line_1 ?? body.addressLine1,
      300
    ),
    address_line_2: validText(
      body.address_line_2 ?? body.addressLine2,
      300
    ),
    apartment: validText(body.apartment, 150),
    city: validText(body.city, 100),
    state: validText(body.state, 100),
    province: validText(body.province, 100),
    postal: validText(
      body.postal ?? body.postal_code ?? body.postalCode,
      30
    ),
    postal_code: validText(
      body.postal_code ?? body.postalCode ?? body.postal,
      30
    ),
    country,
    country_code: countryCode,
    phone: validText(body.phone, 50),
    is_default: body.is_default || body.isDefault ? 1 : 0,
    created_at: createdAt,
    updated_at: createdAt
  };

  const values = { id, user_id: userId, ...mapping };

  const selectedColumns = Object.keys(values).filter(
    column => columns.includes(column)
  );

  const placeholders = selectedColumns.map(() => "?").join(", ");

  await db.prepare(`
    INSERT INTO customer_addresses (
      ${selectedColumns.join(", ")}
    )
    VALUES (${placeholders})
  `).bind(
    ...selectedColumns.map(column => values[column])
  ).run();

  if (mapping.is_default) {
    await setDefaultAddress(db, userId, id);
  }

  return await db.prepare(`
    SELECT *
    FROM customer_addresses
    WHERE id = ? AND user_id = ?
    LIMIT 1
  `).bind(id, userId).first();
}

async function setDefaultAddress(db, userId, addressId) {
  const columns = await getColumns(db, "customer_addresses");

  if (!columns.includes("is_default")) return false;

  const result=await db.prepare(`
    UPDATE customer_addresses
    SET is_default=CASE WHEN id=? THEN 1 ELSE 0 END
    WHERE user_id=? AND EXISTS (
      SELECT 1 FROM customer_addresses WHERE id=? AND user_id=?
    )
  `).bind(addressId,userId,addressId,userId).run();
  return Number(result.meta?.changes||0)>0;
}

async function deleteAddress(db, userId, addressId) {
  const result = await db.prepare(`
    DELETE FROM customer_addresses
    WHERE id = ? AND user_id = ?
  `).bind(addressId, userId).run();

  return Number(result.meta?.changes || 0) > 0;
}

function normalizeOrderItem(item) {
  const quantity = Math.max(
    1,
    Math.min(999, Math.floor(validNumber(item.quantity, 1)))
  );

  const unitPrice = Math.max(
    0,
    validNumber(
      item.unitPrice ?? item.unit_price ?? item.price,
      0
    )
  );

  const totalPrice = Math.max(
    0,
    validNumber(
      item.totalPrice ?? item.total_price,
      unitPrice * quantity
    )
  );

  return {
    id: randomId("item_"),
    productId: validText(
      item.productId ?? item.product_id ?? item.id,
      150
    ),
    title: validText(
      item.title ?? item.name ?? item.productName,
      250
    ),
    variant: validText(
      item.variant ?? item.option ?? item.size,
      250
    ),
    quantity,
    unitPrice,
    totalPrice,
    image: validText(
      item.image ?? item.imageUrl ?? item.image_url,
      1000
    ),
    itemJson: JSON.stringify(item)
  };
}

function normalizeOrderRecord(order) {
  const customer = order.customer || {};
  const items = Array.isArray(order.items) ? order.items : [];

  if (!items.length) {
    throw new AppError("Order information is incomplete.",400);
  }

  if (!customer.email) {
    throw new AppError("Order customer email is missing.",400);
  }

  const normalizedItems = items.map(normalizeOrderItem);

  return {
    orderNumber: validText(order.orderNumber, 100),
    vnCode: validText(order.vnCode, 100),
    createdAt: validText(order.createdAt, 60) || nowISO(),
    customer,
    items: normalizedItems,
    subtotal: Math.max(0, validNumber(order.subtotal)),
    shipping: Math.max(0, validNumber(order.shipping)),
    taxes: Math.max(0, validNumber(order.taxes)),
    total: Math.max(0, validNumber(order.total)),
    currency: validText(order.currency, 10) || "TRY",
    countryCode: validText(order.countryCode, 5),
    shippingMethod: validText(order.shippingMethod, 150),
    paymentMethod: validText(order.paymentMethod, 150),
    originalOrder: order
  };
}

function serializeNormalizedOrder(order) {
  return {
    orderNumber: order.orderNumber,
    vnCode: order.vnCode,
    createdAt: order.createdAt,
    customer: order.customer,
    items: order.items.map(item => ({
      id: item.id,
      productId: item.productId,
      title: item.title,
      variant: item.variant,
      quantity: item.quantity,
      unitPrice: item.unitPrice,
      totalPrice: item.totalPrice,
      image: item.image
    })),
    subtotal: order.subtotal,
    shipping: order.shipping,
    taxes: order.taxes,
    total: order.total,
    currency: order.currency,
    countryCode: order.countryCode,
    shippingMethod: order.shippingMethod,
    paymentMethod: order.paymentMethod
  };
}

async function generateUniqueAdminOrderNumber(db) {
  for (let attempt = 0; attempt < 100; attempt++) {
    const orderNumber = randomDigits(6);

    const existing = await db.prepare(`
      SELECT order_number FROM admin_orders WHERE order_number = ?
      UNION ALL
      SELECT order_number FROM admin_order_queue WHERE order_number = ?
      LIMIT 1
    `).bind(orderNumber, orderNumber).first();

    if (!existing) return orderNumber;
  }

  throw new AppError("Unable to generate a unique order number. Try again.",503);
}

async function generateAdminCode(db) {
  const row = await db.prepare(`UPDATE admin_order_code_sequence SET next_number=next_number+1 WHERE id=1 RETURNING next_number-1 AS allocated`).first();
  const number = Number(row?.allocated);
  if (!Number.isSafeInteger(number) || number < 1) throw new AppError("Unable to allocate a VN-A code.",503);
  return `VN-A${String(number).padStart(2,"0")}`;
}

async function generateUniqueCustomerOrderNumber(db) {
  for (let attempt = 0; attempt < 100; attempt++) {
    const orderNumber = randomDigits(8);

    const existing = await db.prepare(`
      SELECT order_number
      FROM customer_orders
      WHERE order_number = ?
      LIMIT 1
    `).bind(orderNumber).first();

    if (!existing) return orderNumber;
  }

  throw new AppError("Unable to generate a unique order number. Try again.",503);
}

async function generateUniqueCustomerCode(db) {
  const row = await db.prepare(`UPDATE customer_order_code_sequence SET next_number=next_number+1 WHERE id=1 RETURNING next_number-1 AS allocated`).first();
  const number = Number(row?.allocated);
  if (!Number.isSafeInteger(number) || number < 1) throw new AppError("Unable to allocate a customer VN code.",503);
  return "VN-" + String(number).padStart(number <= 999 ? 3 : 4, "0");
}

async function reserveAdminIdentifiers(db, orderId, createdAt=nowISO()) {
  for (let attempt=0;attempt<120;attempt++) {
    const orderNumber=randomDigits(6);
    const codeNumber=Number(randomDigits(6));
    if(!codeNumber) continue;
    const results=await db.batch([
      db.prepare(`INSERT OR IGNORE INTO admin_order_number_registry(order_number,admin_order_id,created_at,state) VALUES (?,?,?,'reserved')`).bind(orderNumber,orderId,createdAt),
      db.prepare(`INSERT OR IGNORE INTO admin_order_code_registry(code_number,admin_order_id,created_at) VALUES (?,?,?)`).bind(codeNumber,orderId,createdAt)
    ]);
    const numberReserved=Boolean(results?.[0]?.meta?.changes);
    const codeReserved=Boolean(results?.[1]?.meta?.changes);
    if(numberReserved&&codeReserved) return {orderNumber,vnCode:`VN-A${String(codeNumber).padStart(2,"0")}`,codeNumber};
    await db.batch([
      db.prepare(`DELETE FROM admin_order_number_registry WHERE admin_order_id=?`).bind(orderId),
      db.prepare(`DELETE FROM admin_order_code_registry WHERE admin_order_id=?`).bind(orderId)
    ]);
  }
  throw new AppError("Unable to reserve unique admin order identifiers. Try again.",503);
}

