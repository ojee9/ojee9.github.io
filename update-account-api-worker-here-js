        .bind(identifiers.orderNumber,identifiers.vnCode,paymentNumber,JSON.stringify(orderObject),draft.id).run();
    } else {
      await db.prepare(`INSERT OR IGNORE INTO admin_order_number_registry(order_number,admin_order_id,created_at,state) VALUES (?,?,?,'reserved')`)
        .bind(draft.order_number,draft.id,draft.created_at||nowISO()).run();
      const codeNumber=Number(String(draft.vn_code||"").replace(/^VN-A/,""));
      if(Number.isSafeInteger(codeNumber)&&codeNumber>0) await db.prepare(`INSERT OR IGNORE INTO admin_order_code_registry(code_number,admin_order_id,created_at) VALUES (?,?,?)`)
        .bind(codeNumber,draft.id,draft.created_at||nowISO()).run();
    }
  }
  schemaReady = true;
  })();
  try {
    await schemaPromise;
  } catch (err) {
    schemaPromise = null;
    throw err;
  }
}

async function ensureProfile(db, userId, claims = {}) {
  const existing = await db.prepare(`
    SELECT *
    FROM customer_profiles
    WHERE user_id = ?
    LIMIT 1
  `).bind(userId).first();

  if (existing) return existing;

  const columns = await getColumns(db, "customer_profiles");

  const values = {
    user_id: userId,
    email: normalizeEmail(
      claims.email || claims.email_address || ""
    ),
    created_at: nowISO(),
    updated_at: nowISO()
  };

  const selectedColumns = Object.keys(values).filter(
    column => columns.includes(column)
  );

  const placeholders = selectedColumns.map(() => "?").join(", ");

  await db.prepare(`
    INSERT OR IGNORE INTO customer_profiles (
      ${selectedColumns.join(", ")}
    )
    VALUES (${placeholders})
  `).bind(
    ...selectedColumns.map(column => values[column])
  ).run();

  return await db.prepare(`
    SELECT *
    FROM customer_profiles
    WHERE user_id = ?
    LIMIT 1
  `).bind(userId).first();
}

